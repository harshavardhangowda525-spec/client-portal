# ---- Required ----
# Postgres connection string. The role MUST NOT be a superuser or have BYPASSRLS,
# otherwise Row Level Security is not enforced (Admin → Settings shows the status).
DATABASE_URL=postgres://portal_owner:portal_owner@localhost:5432/portal
# Public base URL of the portal, used in invitation links and emails.
APP_URL=http://localhost:3000
# Set to "true" when serving over HTTPS (production) so cookies are Secure.
COOKIE_SECURE=false

# ---- Optional: one-time browser admin setup (alternative to `npm run admin:create`) ----
# When set AND no admin exists yet, /setup accepts this token once to create the first admin.
# Remove it after setup.
ADMIN_SETUP_TOKEN=

# ---- Optional: email (SMTP). Leave blank to use "copy link" delivery. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Infinity Web & Apps <no-reply@example.com>"

# ---- Optional: WhatsApp Cloud API. Leave blank to share links manually via wa.me ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template name with a single body parameter (the message/link)
WHATSAPP_TEMPLATE_NAME=

# ---- Optional: Razorpay (online payments). Leave blank to disable online payments. ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Company details printed on quotations, invoices and receipts ----
COMPANY_NAME="Infinity Web & Apps"
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_TAX_ID=
